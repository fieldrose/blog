---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCategoryTree } from "@/utils/getCategories";
import { categoryMeta } from "@/data/categories";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts");
const categories = getCategoryTree(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.categoriesTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <Main pageTitle={t.pages.categoriesTitle} pageDesc={t.pages.categoriesDesc}>
    <ul class="space-y-4">
      {
        categories.map(category => (
          <li>
            <a
              href={getRelativeLocaleUrl(
                locale,
                `categories/${category.slug}/`
              )}
              class="border-muted-foreground/30 bg-muted/30 hover:border-accent block rounded-lg border border-dashed p-4 text-current no-underline transition"
            >
              <div class="flex items-baseline justify-between gap-3">
                <span class="text-lg font-medium">{category.name}</span>
                <span class="text-muted-foreground text-sm whitespace-nowrap">
                  {tplStr(t.categories.count, { count: category.count })}
                </span>
              </div>
              {categoryMeta[category.name]?.description && (
                <p class="text-muted-foreground mt-1 text-sm">
                  {categoryMeta[category.name].description}
                </p>
              )}
              {category.children.length > 0 && (
                <div class="text-muted-foreground mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm">
                  {category.children.map(child => (
                    <span>
                      {child.name}
                      <span class="text-xs"> ({child.count})</span>
                    </span>
                  ))}
                </div>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
