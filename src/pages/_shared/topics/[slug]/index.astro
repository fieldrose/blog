---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { resolveTopics } from "@/utils/getTopics";
import { topics } from "@/data/topics";
import config from "@/config";

export const getStaticPaths = (() =>
  topics.map(topic => ({
    params: { slug: topic.slug },
    props: { slug: topic.slug },
  }))) satisfies GetStaticPaths;

const { slug } = Astro.props;
const topic = resolveTopics(await getCollection("posts")).find(
  item => item.slug === slug
);

if (!topic) {
  throw new Error(`[topics] 未找到专题: ${slug}`);
}

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout title={`${topic.title} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <Main pageTitle={topic.title} pageDesc={topic.description}>
    <ol class="list-decimal pl-6">
      {
        topic.items.map(({ post, note }) => (
          <li class="my-6">
            <a
              href={getPostUrl(post.id, post.filePath, locale)}
              class="text-accent text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
            >
              {post.data.title}
            </a>
            <Datetime {...post.data} />
            {note && (
              <p class="text-muted-foreground mt-1 text-sm">{note}</p>
            )}
          </li>
        ))
      }
    </ol>
  </Main>

  <Footer />
</Layout>
