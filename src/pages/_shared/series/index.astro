---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);

// 提取所有 series，按文章数倒序
const seriesMap = new Map<
  string,
  { name: string; count: number; firstOrder: number; firstDate: Date }
>();
for (const p of posts) {
  const s = p.data.series;
  if (!s) continue;
  const existing = seriesMap.get(s);
  if (existing) {
    existing.count++;
    if ((p.data.seriesOrder ?? 999) < existing.firstOrder) {
      existing.firstOrder = p.data.seriesOrder ?? 999;
      existing.firstDate = p.data.pubDatetime;
    }
  } else {
    seriesMap.set(s, {
      name: s,
      count: 1,
      firstOrder: p.data.seriesOrder ?? 999,
      firstDate: p.data.pubDatetime,
    });
  }
}

const seriesList = Array.from(seriesMap.values()).sort(
  (a, b) => b.firstDate.getTime() - a.firstDate.getTime()
);

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout title={`专栏 | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <Main pageTitle="专栏" pageDesc="按主题组织的系列文章">
    <ul class="grid gap-6 sm:grid-cols-2">
      {
        seriesList.map(s => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `series/${s.name}/`)}
              class="block rounded-lg border border-dashed border-muted-foreground/30 bg-muted/30 p-4 text-current no-underline transition hover:border-accent hover:text-accent"
            >
              <div class="text-lg font-medium">{s.name}</div>
              <div class="mt-1 text-sm text-muted-foreground">
                共 {s.count} 篇
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
