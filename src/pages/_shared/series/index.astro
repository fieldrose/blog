---
// 专栏索引页，列出全部专栏及文章数。
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getSeriesList } from "@/utils/getSeriesList";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const seriesList = getSeriesList(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.seriesTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />

  <Main pageTitle={t.pages.seriesTitle} pageDesc={t.pages.seriesDesc}>
    <ul class="grid gap-6 sm:grid-cols-2">
      {
        seriesList.map(s => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `series/${s.name}/`)}
              class="block rounded-lg border border-dashed border-muted-foreground/30 bg-muted/30 p-4 text-current no-underline transition hover:border-accent hover:text-accent"
            >
              <div class="text-lg font-medium">{s.name}</div>
              <div class="mt-1 text-sm text-muted-foreground">
                {tplStr(t.pages.seriesCount, { count: s.count })}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
