---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import DemoCard from "@/components/demo/DemoCard.astro";
import type { DemoMeta } from "@/types/demo";
import { useTranslations } from "@/i18n";
import config from "@/config";

// ---------- 静态 import 所有 demo 组件 ----------
// Astro 7 不支持 <component is={变量}> 动态渲染组件，
// 必须在模板里直接写 <ComponentName />，所以所有 demo 组件都要静态 import。
//
// framework 约定：
//   astro  → 纯 SSR，直接 <Foo />
//   react  → island，<Foo client:visible />
//   vue    → island，<Foo client:visible />
//   native → 直接输出 src/demos/<slug>/Demo.html 原始片段，不引入任何组件
import BlobGlow from "@/demos/blob-glow/Demo.astro";
import GradientText from "@/demos/gradient-text/Demo.astro";
import HoverCard from "@/demos/hover-card/Demo.astro";
import PulseDots from "@/demos/pulse-dots/Demo.astro";
import ReactCounter from "@/demos/react-counter/Demo.tsx";
import VueCounter from "@/demos/vue-counter/Demo.vue";
import SkeletonVue from "@/demos/skeleton-vue/Demo.vue";

// ---------- slug → 组件 注册表 ----------
// 仅用于运行时存在性检查；实际渲染必须在模板里显式写。
const COMPONENT_REGISTRY: Record<string, any> = {
  "blob-glow": BlobGlow,
  "gradient-text": GradientText,
  "hover-card": HoverCard,
  "pulse-dots": PulseDots,
  "react-counter": ReactCounter,
  "vue-counter": VueCounter,
  "skeleton-vue": SkeletonVue,
};

// ---------- native 原始片段 ----------
// native 类型不经过任何框架组件，直接输出 Demo.html 原文（含可选的 style/script）。
// 脚本若需在客户端路由切换后重复执行，由 demo 自己在标签上加 data-astro-rerun。
const nativeHtml = import.meta.glob<string>("@/demos/*/Demo.html", {
  query: "?raw",
  import: "default",
  eager: true,
});
const nativeBySlug: Record<string, string> = Object.fromEntries(
  Object.entries(nativeHtml).map(([path, html]) => [
    path.split("/").slice(-2, -1)[0]!,
    html,
  ]),
);

// ---------- glob 拿所有 meta ----------
const metaGlobs = import.meta.glob<{ default: DemoMeta }>(
  "@/demos/*/meta.ts",
  { eager: true },
);

// ---------- 合并 + 排序 ----------
const metas = Object.entries(metaGlobs).map(([path, mod]) => {
  const slug = path.split("/").slice(-2, -1)[0]!;
  return { slug, meta: mod.default };
});
metas.sort((a, b) => a.meta.order - b.meta.order);

const locale = (Astro.currentLocale ?? config.site.lang) as "zh" | "en";
const t = useTranslations(locale);
---

<Layout
  title={`${t.demos.title} | ${config.site.title}`}
  description={t.demos.description}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.demos.title}>
    <p class="text-muted-foreground mb-8 text-sm">{t.demos.description}</p>

    <div class="grid gap-6 sm:grid-cols-2">
      {
        metas.map(({ slug, meta }) => (
          <DemoCard slug={slug} meta={meta} locale={locale}>
            {slug === "blob-glow" && <BlobGlow />}
            {slug === "gradient-text" && <GradientText />}
            {slug === "hover-card" && <HoverCard />}
            {slug === "pulse-dots" && <PulseDots />}
            {/* React/Vue island 需要 client:visible 才能 hydration */}
            {slug === "react-counter" && <ReactCounter client:visible />}
            {slug === "vue-counter" && <VueCounter client:visible />}
            {slug === "skeleton-vue" && <SkeletonVue client:visible />}
            {/* native：直接注入原始片段，不引入框架 */}
            {meta.framework === "native" && nativeBySlug[slug] && (
              <Fragment set:html={nativeBySlug[slug]} />
            )}
            {meta.framework !== "native" && !COMPONENT_REGISTRY[slug] && (
              <p class="text-red-500 text-sm">[demos] 组件未注册：{slug}</p>
            )}
            {meta.framework === "native" && !nativeBySlug[slug] && (
              <p class="text-red-500 text-sm">
                [demos] 缺少 Demo.html：{slug}
              </p>
            )}
          </DemoCard>
        ))
      }
    </div>
  </Main>
  <Footer />
</Layout>
