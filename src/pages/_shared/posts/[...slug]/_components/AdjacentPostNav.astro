---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
  /** 当前文章属于专栏时设置，此时前后篇为专栏内文章。 */
  seriesNav?: { name: string } | null;
};

const { prevPost, nextPost, seriesNav = null } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// 专栏内使用专栏导航文案，独立文章使用普通文章文案
const prevLabel = seriesNav ? t.post.previousInSeries : t.post.previousPost;
const nextLabel = seriesNav ? t.post.nextInSeries : t.post.nextPost;
const seriesUrl = seriesNav
  ? getRelativeLocaleUrl(locale, `series/${seriesNav.name}/`)
  : "";
---

<div data-pagefind-ignore class="my-8 grid grid-cols-1 gap-6 sm:grid-cols-2">
  {
    prevPost && (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
        class="border-border hover:border-accent/60 hover:bg-muted/30 flex w-full gap-2 rounded-lg border p-3 transition-colors"
      >
        <IconArrowLeft class="text-accent inline-block flex-none self-center rtl:rotate-180" />
        <div>
          <span class="text-muted-foreground text-sm">{prevLabel}</span>
          <div class="text-accent/85 text-sm">{prevPost.title}</div>
        </div>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class="border-border hover:border-accent/60 hover:bg-muted/30 flex w-full justify-end gap-2 rounded-lg border p-3 text-end transition-colors sm:col-start-2"
      >
        <div>
          <span class="text-muted-foreground text-sm">{nextLabel}</span>
          <div class="text-accent/85 text-sm">{nextPost.title}</div>
        </div>
        <IconArrowRight class="text-accent inline-block flex-none self-center rtl:rotate-180" />
      </a>
    )
  }
  {
    seriesNav && (
      <a
        href={seriesUrl}
        class="text-muted-foreground hover:text-accent text-center text-sm no-underline sm:col-span-2"
      >
        {t.post.backToSeries}
        <span class="text-foreground/70"> · {seriesNav.name}</span>
      </a>
    )
  }
</div>
