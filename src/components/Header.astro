---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import IconLanguage from "@/assets/icons/IconLanguage.svg";
import IconHash from "@/assets/icons/IconHash.svg";
import IconEdit from "@/assets/icons/IconEdit.svg";
import IconStar from "@/assets/icons/IconStar.svg";
import LinkButton from "./LinkButton.astro";
import UserMenu from "@/components/react/UserMenu.tsx";
import ReadingSettings from "@/components/vue/ReadingSettings.vue";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import { locales } from "@/i18n/locales";
import { hasSupabasePublicEnv } from "@/lib/env";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const showAuth = features.auth && hasSupabasePublicEnv;
const showReadingSettings = features.readingSettings;

const localeMenu = locales.map(loc => ({
  ...loc,
  href: getRelativeLocaleUrl(loc.code, currentPath || ""),
  active: loc.code === locale,
}));

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="bg-background text-accent absolute inset-s-16 -top-full z-50 px-3 py-2 backdrop-blur-lg transition-all focus:top-4"
>
  {t.a11y.skipToContent}
</a>

<header
  class="app-layout flex flex-col items-center justify-between sm:flex-row"
>
  <div
    class="border-border bg-background flex w-full items-center justify-between border-b py-4 sm:py-6"
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="text-xl leading-8 font-semibold whitespace-nowrap sm:text-2xl sm:leading-none"
    >
      {site.title}
    </a>

    <!-- 桌面端水平导航 -->
    <nav class="ms-auto hidden sm:flex sm:items-center sm:gap-x-4">
      <a
        href={getRelativeLocaleUrl(locale, "posts")}
        class:list={[
          "hover:text-accent block px-2 py-1 font-medium",
          { "active-nav": isActive("/posts") },
        ]}
      >
        {t.nav.posts}
      </a>
      <a
        href={getRelativeLocaleUrl(locale, "tags")}
        class:list={[
          "hover:text-accent block px-2 py-1 font-medium",
          { "active-nav": isActive("/tags") },
        ]}
      >
        {t.nav.tags}
      </a>
      <a
        href={getRelativeLocaleUrl(locale, "about")}
        class:list={[
          "hover:text-accent block px-2 py-1 font-medium",
          { "active-nav": isActive("/about") },
        ]}
      >
        {t.nav.about}
      </a>
      {
        features.showArchives && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "archives")}
            class:list={[
              "focus-outline relative size-8",
              { "active-nav": isActive("/archives") },
            ]}
            title={t.nav.archives}
            aria-label={t.nav.archives}
          >
            <IconArchive class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
            <span class="sr-only">{t.nav.archives}</span>
            {isActive("/archives") && (
              <IconUnderline
                aria-hidden="true"
                class="absolute bottom-0 w-6 scale-125"
              />
            )}
          </LinkButton>
        )
      }
      {
        features.search !== false && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "search")}
            class="focus-outline relative size-8"
            title={t.nav.search}
            aria-label={t.nav.search}
          >
            <IconSearch class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2" />
            <span class="sr-only">{t.nav.search}</span>
            {isActive("/search") && (
              <IconUnderline
                aria-hidden="true"
                class="absolute bottom-0 w-6 scale-125"
              />
            )}
          </LinkButton>
        )
      }
      {
        features.lightAndDarkMode && (
          <button
            id="theme-btn"
            class="focus-outline hover:[&>svg]:stroke-accent relative size-8"
            title={t.a11y.toggleTheme}
            aria-label="auto"
            aria-live="polite"
          >
            <IconMoon class="absolute top-[50%] left-[50%] size-6 translate-[-50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute top-[50%] left-[50%] size-6 translate-[-50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </button>
        )
      }
      <div class="relative inline-flex items-center">
        <button
          id="lang-btn"
          class="focus-outline hover:[&>svg]:stroke-accent relative size-8"
          title="Language"
          aria-label="Language"
          aria-expanded="false"
          aria-controls="lang-menu"
        >
          <IconLanguage
            class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2 stroke-current"
          />
        </button>
        <ul
          id="lang-menu"
          class="bg-background border-border absolute top-full right-0 z-50 mt-2 hidden min-w-[140px] overflow-hidden rounded-lg border shadow-lg"
          role="menu"
        >
          {
            localeMenu.map(item => (
              <li role="none">
                <a
                  href={item.href}
                  role="menuitem"
                  class:list={[
                    "block px-4 py-2 text-sm transition-colors",
                    item.active
                      ? "bg-accent/10 text-accent"
                      : "hover:bg-muted hover:text-accent",
                  ]}
                >
                  <span>{item.label}</span>
                  <span class="text-muted ml-1 text-xs">({item.labelEn})</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {
        showReadingSettings && (
          <ReadingSettings client:idle labels={t.readingSettings} />
        )
      }
      {showAuth && <UserMenu client:idle labels={t.auth} />}
    </nav>

    <!-- 移动端汉堡按钮（与标题同行，靠右） -->
    <button
      id="menu-btn"
      class="focus-outline p-2 sm:hidden"
      aria-label={t.a11y.openMenu}
      aria-expanded="false"
      aria-controls="menu-drawer"
    >
      <IconMenuDeep />
    </button>
  </div>
</header>

<!-- 移动端右侧抽屉 -->
<div
  id="menu-overlay"
  class="pointer-events-none fixed inset-0 z-40 bg-black/50 opacity-0 transition-opacity duration-300 sm:hidden"
  aria-hidden="true"
>
</div>

<aside
  id="menu-drawer"
  class="bg-background border-border fixed top-0 right-0 z-50 flex h-full w-72 max-w-[85vw] translate-x-full flex-col border-l shadow-xl transition-transform duration-300 ease-out sm:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
>
  <div
    class="border-border flex items-center justify-between border-b px-4 py-4"
  >
    <span class="text-base font-semibold">{t.nav.settings}</span>
    <button
      id="drawer-close"
      class="focus-outline p-2"
      aria-label={t.a11y.closeMenu}
    >
      <IconX />
    </button>
  </div>

  <nav class="flex flex-1 flex-col overflow-y-auto px-2 py-4">
    <div class="flex flex-col">
      <a
        href={getRelativeLocaleUrl(locale, "posts")}
        class:list={[
          "hover:bg-muted hover:text-accent flex items-center gap-3 rounded-lg px-4 py-3 text-base font-medium transition-colors",
          isActive("/posts") && "bg-accent/10 text-accent",
        ]}
      >
        <IconEdit class="size-5" />
        {t.nav.posts}
      </a>
      <a
        href={getRelativeLocaleUrl(locale, "tags")}
        class:list={[
          "hover:bg-muted hover:text-accent flex items-center gap-3 rounded-lg px-4 py-3 text-base font-medium transition-colors",
          isActive("/tags") && "bg-accent/10 text-accent",
        ]}
      >
        <IconHash class="size-5" />
        {t.nav.tags}
      </a>
      <a
        href={getRelativeLocaleUrl(locale, "about")}
        class:list={[
          "hover:bg-muted hover:text-accent flex items-center gap-3 rounded-lg px-4 py-3 text-base font-medium transition-colors",
          isActive("/about") && "bg-accent/10 text-accent",
        ]}
      >
        <IconStar class="size-5" />
        {t.nav.about}
      </a>
      {
        features.showArchives && (
          <LinkButton
            href={getRelativeLocaleUrl(locale, "archives")}
            class:list={[
              "focus-outline hover:bg-muted hover:text-accent flex items-center gap-3 rounded-lg px-4 py-3 text-base font-medium transition-colors",
              isActive("/archives") && "bg-accent/10 text-accent",
            ]}
          >
            <IconArchive class="size-5" />
            {t.nav.archives}
          </LinkButton>
        )
      }
    </div>

    <div class="border-border my-4 border-t"></div>

    {
      features.search !== false && (
        <LinkButton
          href={getRelativeLocaleUrl(locale, "search")}
          class:list={[
            "focus-outline hover:bg-muted hover:text-accent flex items-center gap-3 rounded-lg px-4 py-3 text-base font-medium transition-colors",
            isActive("/search") && "bg-accent/10 text-accent",
          ]}
        >
          <IconSearch class="size-5" />
          {t.nav.search}
        </LinkButton>
      )
    }

    {
      features.lightAndDarkMode && (
        <button
          id="theme-btn-mobile"
          class="focus-outline hover:[&>svg]:stroke-accent hover:bg-muted hover:text-accent flex items-center gap-3 rounded-lg px-4 py-3 text-base font-medium transition-colors"
          title={t.a11y.toggleTheme}
          aria-label="auto"
          aria-live="polite"
        >
          <span class="relative size-5">
            <IconMoon class="absolute inset-0 size-5 scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
            <IconSunHigh class="absolute inset-0 size-5 scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
          </span>
          <span>{t.a11y.toggleTheme}</span>
        </button>
      )
    }

    <div class="px-4 py-2">
      <div class="text-muted-foreground mb-2 flex items-center gap-2 text-sm">
        <IconLanguage class="size-4" />
        {t.nav.language}
      </div>
      <div class="flex flex-col gap-1">
        {
          localeMenu.map(item => (
            <a
              href={item.href}
              class:list={[
                "rounded-md px-3 py-2 text-sm transition-colors",
                item.active
                  ? "bg-accent/10 text-accent font-medium"
                  : "hover:bg-muted hover:text-accent",
              ]}
            >
              {item.label}{" "}
              <span class="text-muted text-xs">({item.labelEn})</span>
            </a>
          ))
        }
      </div>
    </div>

    {
      showReadingSettings && (
        <div class="border-border mt-2 border-t pt-2">
          <ReadingSettings
            client:idle
            labels={t.readingSettings}
            inline={true}
          />
        </div>
      )
    }

    {
      showAuth && (
        <div class="border-border mt-2 border-t pt-2">
          <UserMenu client:idle labels={t.auth} />
        </div>
      )
    }
  </nav>
</aside>

<script>
  function initDrawer() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const drawer = document.querySelector<HTMLElement>("#menu-drawer");
    const overlay = document.querySelector<HTMLElement>("#menu-overlay");
    const closeBtn = document.querySelector<HTMLButtonElement>("#drawer-close");
    if (!menuBtn || !drawer || !overlay || !closeBtn) return;

    const openDrawer = () => {
      drawer.classList.remove("translate-x-full");
      overlay.classList.remove("pointer-events-none", "opacity-0");
      overlay.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      menuBtn.setAttribute("aria-expanded", "true");
    };

    const closeDrawer = () => {
      drawer.classList.add("translate-x-full");
      overlay.classList.add("pointer-events-none", "opacity-0");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      menuBtn.setAttribute("aria-expanded", "false");
    };

    menuBtn.addEventListener("click", () => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";
      if (isOpen) closeDrawer();
      else openDrawer();
    });

    closeBtn.addEventListener("click", closeDrawer);
    overlay.addEventListener("click", closeDrawer);

    document.addEventListener("keydown", e => {
      if (
        e.key === "Escape" &&
        menuBtn.getAttribute("aria-expanded") === "true"
      ) {
        closeDrawer();
      }
    });
  }

  function initLangMenu() {
    const btn = document.querySelector<HTMLButtonElement>("#lang-btn");
    const menu = document.querySelector<HTMLUListElement>("#lang-menu");
    if (!btn || !menu) return;

    const close = () => {
      btn.setAttribute("aria-expanded", "false");
      menu.classList.add("hidden");
    };

    btn.addEventListener("click", e => {
      e.stopPropagation();
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      if (isOpen) close();
      else {
        btn.setAttribute("aria-expanded", "true");
        menu.classList.remove("hidden");
      }
    });

    document.addEventListener("click", e => {
      if (!menu.contains(e.target as Node) && !btn.contains(e.target as Node)) {
        close();
      }
    });

    document.addEventListener("keydown", e => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        close();
      }
    });
  }

  initDrawer();
  document.addEventListener("astro:after-swap", initDrawer);
  document.addEventListener("astro:after-swap", () => {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    if (menuBtn) menuBtn.setAttribute("aria-expanded", "false");
    const drawer = document.querySelector<HTMLElement>("#menu-drawer");
    const overlay = document.querySelector<HTMLElement>("#menu-overlay");
    if (drawer) drawer.classList.add("translate-x-full");
    if (overlay) {
      overlay.classList.add("pointer-events-none", "opacity-0");
      overlay.setAttribute("aria-hidden", "true");
    }
    document.body.style.overflow = "";
  });

  initLangMenu();
  document.addEventListener("astro:after-swap", initLangMenu);
</script>
