# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in real values. Never commit .env.local.
# All variables are OPTIONAL at build time (CI builds without them),
# but the dynamic features are disabled until their values are present.
# ─────────────────────────────────────────────────────────────

# Canonical site URL (used for sitemap/RSS/canonical/OG + OAuth redirect base).
# Local dev: http://localhost:4321 ; Prod: https://your-domain.com
PUBLIC_SITE_URL="http://localhost:4321"

# ── Supabase ─────────────────────────────────────────────────
# Project settings → API. Both public values are safe to expose (RLS protects data).
PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Project settings → API → service_role secret. SERVER ONLY.
# Must never be imported by client components (lint rule enforces this).
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ── AI (OpenAI-compatible: OpenAI / DeepSeek / Zhipu / etc.) ─
# SERVER ONLY. Leave blank to disable the AI assistant (UI hides itself, API 503).
AI_API_BASE_URL="https://api.openai.com/v1"
AI_API_KEY="your-ai-api-key"
AI_CHAT_MODEL="gpt-4o-mini"
AI_EMBEDDING_MODEL="text-embedding-3-small"
# Must match the embedding model dimension; changing it requires `pnpm ai:ingest` again.
AI_EMBEDDING_DIM="1536"

# ── Direct Postgres (migrations only, NOT used by the site runtime) ─
# Dashboard → Project Settings → Database → Connection string (pooler).
# URL-encode special characters in the password (e.g. @ → %40).
# DATABASE_URL="postgresql://postgres.<ref>:<encoded-password>@aws-1-<region>.pooler.supabase.com:6543/postgres"

# ── Auth callback configuration ───────────────────────────────
# OAuth/email confirmation redirects land on PUBLIC_SITE_URL + /<locale>/auth/callback.
# Register each environment URL under Supabase → Authentication → URL Configuration:
#   http://localhost:4321/zh/auth/callback
#   https://<preview>.netlify.app/zh/auth/callback
#   https://<your-domain>/zh/auth/callback
# Enable the GitHub provider under Authentication → Providers to use it.

# ── Existing AstroPaper variables ────────────────────────────
# Google Search Console verification (optional).
# PUBLIC_GOOGLE_SITE_VERIFICATION=""
