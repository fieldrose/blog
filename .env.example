# ─────────────────────────────────────────────────────────────
# 复制为 `.env.local` 并填入真实值，切勿提交 .env.local。
# 所有变量在构建期都是可选的（CI 不配置也能构建），
# 但缺少对应值时相关动态能力会关闭。
# ─────────────────────────────────────────────────────────────

# 站点规范 URL（用于 sitemap、RSS、canonical、OG 图与 OAuth 回调基址）。
# 本地开发：http://localhost:4321 ；线上：https://your-domain.com
PUBLIC_SITE_URL="http://localhost:4321"

# ── Supabase ─────────────────────────────────────────────────
# 项目设置 → API。两个公开值可以暴露给浏览器（数据由 RLS 保护）。
PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# 项目设置 → API → service_role 密钥，仅服务端使用。
# 禁止在客户端组件中引入（已由 lint 规则约束）。
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ── AI（兼容 OpenAI 协议：OpenAI / DeepSeek / 智谱等）─────────
# 仅服务端使用。留空即关闭 AI 助手（界面自动隐藏，接口返回 503）。
AI_API_BASE_URL="https://api.openai.com/v1"
AI_API_KEY="your-ai-api-key"
AI_CHAT_MODEL="gpt-4o-mini"
AI_EMBEDDING_MODEL="text-embedding-3-small"
# 必须与嵌入模型维度一致；修改后需要重新执行 `pnpm ai:ingest`。
AI_EMBEDDING_DIM="1536"

# ── 直连 Postgres（仅用于数据库迁移，站点运行时不使用）────────
# 控制台 → 项目设置 → Database → 连接串（连接池）。
# 密码中的特殊字符需要 URL 编码（例如 @ 写成 %40）。
# DATABASE_URL="postgresql://postgres.<ref>:<encoded-password>@aws-1-<region>.pooler.supabase.com:6543/postgres"

# ── 认证回调配置 ──────────────────────────────────────────────
# OAuth / 邮箱确认会回到 PUBLIC_SITE_URL + /<locale>/auth/callback。
# 需要在 Supabase → Authentication → URL Configuration 中登记各环境地址：
#   http://localhost:4321/zh/auth/callback
#   https://<preview>.netlify.app/zh/auth/callback
#   https://<your-domain>/zh/auth/callback
# 如需 GitHub 登录，还需在 Authentication → Providers 中启用 GitHub。

# ── 已有变量 ──────────────────────────────────────────────────
# Google Search Console 站点验证（可选）。
# PUBLIC_GOOGLE_SITE_VERIFICATION=""
